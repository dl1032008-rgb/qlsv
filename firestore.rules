rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Master Gate
    match /{document=**} {
      allow read, write: if false;
    }

    // Classes
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Students
    match /students/{studentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
